{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "systems.schema.json",
  "title": "Emulator systems config (master list)",
  "description": "Master-list format: a top-level emulators[] registry (one stable id per app, with its packages and links) plus the systems[] entries below that reference ids. Variant-only fields (core, extras, mimeType, activity, favourite) stay on the system entry.",
  "type": "object",
  "required": ["emulators", "systems"],
  "properties": {
    "emulators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "packages", "siteUrl"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "packages": { "type": "array", "items": { "type": "string", "pattern": "^[a-zA-Z0-9.]+$" } },
          "siteUrl": { "type": "string", "pattern": "^https?://" },
          "playStoreUrl": { "type": "string", "pattern": "^https?://" },
          "apkUrl": { "type": "string", "pattern": "^https?://" },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "label", "url"],
              "properties": {
                "kind": { "enum": ["play", "fdroid", "github", "apk", "web"] },
                "label": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "pattern": "^https?://" },
                "install": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "folder", "emulators"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "folder": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "romExtensions": { "type": "array", "items": { "type": "string" } },
          "logoKey": { "type": "string" },
          "hue": { "type": "integer", "minimum": 0, "maximum": 359 },
          "mame": { "type": "boolean" },
          "emulators": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["emulator"],
              "properties": {
                "emulator": { "type": "string" },
                "core": { "type": "string", "minLength": 1 },
                "extras": { "type": "object" },
                "mimeType": { "type": "string" },
                "activity": { "type": "string" },
                "favourite": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
